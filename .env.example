# Copy to .env and fill in.

# ---- RPC / chain ----
RPC_URL=https://sepolia.infura.io/v3/<your-key>
CHAIN_ID=11155111

# ---- Deployed addresses (fill after running scripts/Deploy.s.sol) ----
SBT_ADDRESS=0x...
REWARDS_ADDRESS=0x...
PAYMASTER_ADDRESS=0x...
ENTRYPOINT_ADDRESS=0x0000000071727De22E5E9d8BAf0edAc6f37da032

# ---- Keys ----
DEPLOYER_KEY=0x...
PAYMASTER_SIGNER_KEY=0x...

# ---- Roles ----
ADMIN=0x...
REWARD_TOKEN=0x...
OPS_WALLET=0x...
BURN_SINK=0x000000000000000000000000000000000000dEaD
PAYMASTER_SIGNER=0x...

# ---- Database ----
DATABASE_URL=postgres://postgres:postgres@localhost:5432/membership

# ---- Tenderly ----
TENDERLY_ACCOUNT=<account-slug>
TENDERLY_PROJECT=<project-slug>
TENDERLY_ACCESS_KEY=<access-key>

# ---- Server ----
PORT=8080
